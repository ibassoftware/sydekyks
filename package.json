{
  "name": "sydekyks",
  "version": "1.0.0",
  "description": "A local-first AI command desk for your business systems",
  "main": "./out/main/index.js",
  "author": "Sydekyks",
  "scripts": {
    "skills:sync": "node scripts/sync-preset-skills.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:mastra": "tsc --noEmit -p tsconfig.mastra.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:mastra",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:mastra": "mastra build",
    "build": "npm run skills:sync && npm run typecheck && npm run build:mastra && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "release:check:mac": "node scripts/validate-release-environment.mjs mac",
    "release:check:win": "node scripts/validate-release-environment.mjs win",
    "release:check:linux": "node scripts/validate-release-environment.mjs linux",
    "release:mac": "npm run release:check:mac && npm run build && electron-builder --mac --config electron-builder.release.yml --publish never",
    "release:win": "npm run release:check:win && npm run build && electron-builder --win --config electron-builder.release.yml --publish never",
    "release:linux": "npm run release:check:linux && npm run build && electron-builder --linux --config electron-builder.release.yml --publish never",
    "test:smoke:worker": "node scripts/smoke-worker.mjs",
    "test:smoke:packaged-worker": "node scripts/smoke-worker.mjs --packaged",
    "test:smoke:packaged-app": "node scripts/smoke-packaged-app.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:recovery": "node scripts/test-database-recovery.mjs",
    "test:logging": "node --no-warnings --experimental-strip-types scripts/test-structured-logging.mjs",
    "test:mission-notifications": "node --no-warnings --experimental-strip-types scripts/test-mission-notifications.mjs",
    "test:mission-errors": "node scripts/test-mission-error-details.mjs",
    "test:syd-odoo-read": "node --no-warnings --experimental-strip-types scripts/test-syd-odoo-read.mjs",
    "test:sidekicks": "node scripts/test-dynamic-sidekicks.mjs",
    "test:ui-contrast": "node scripts/test-ui-contrast.mjs",
    "test:ai-restore": "node --no-warnings --experimental-strip-types scripts/test-ai-runtime-restore.mjs",
    "test:openai-models": "node --no-warnings --experimental-strip-types scripts/test-openai-model-filter.mjs",
    "test:ai-provider-policy": "node scripts/test-ai-provider-policy.mjs",
    "test:functional": "node scripts/test-functional-matrix.mjs",
    "test:functional:greenmail": "node scripts/test-functional-matrix.mjs --greenmail",
    "test:functional:live-odoo": "node scripts/test-functional-matrix.mjs --live-odoo",
    "test:live:stored-connections": "electron scripts/electron-live-test-bootstrap.cjs",
    "test:imap:up": "docker compose -f compose.greenmail.yml up -d --wait",
    "test:imap:down": "docker compose -f compose.greenmail.yml down --volumes"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.34",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@libsql/client": "^0.17.4",
    "@mastra/ai-sdk": "^1.6.2",
    "@mastra/core": "^1.51.0",
    "@mastra/libsql": "^1.16.0",
    "@mastra/memory": "^1.23.0",
    "ai": "^7.0.31",
    "electron-updater": "^6.8.9",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "mastra": "^1.19.0",
    "pdfjs-dist": "^6.1.200",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
